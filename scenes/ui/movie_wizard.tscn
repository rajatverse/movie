[gd_scene load_steps=2 format=3 uid="uid://movie_wizard_scene"]

[ext_resource type="Script" path="res://scenes/ui/movie_wizard.gd" id="1_wizard"]

[node name="MovieWizard" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_wizard")

[node name="WizardPanel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="WizardPanel"]
layout_mode = 2
theme_override_constants/separation = 0

